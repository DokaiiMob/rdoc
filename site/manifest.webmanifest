{
  "name": "rdoc playground",
  "short_name": "rdoc",
  "description": "Convert Markdown to self-contained .rdoc.html offline in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F3EFE6",
  "theme_color": "#0B6E4F",
  "lang": "en",
  "icons": [
    {
      "src": "./icons/rdoc-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/rdoc-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/rdoc-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
