{
  "name": "rdoc",
  "version": "0.1.0",
  "description": "CLI and compiler for .rdoc — self-contained responsive offline documents",
  "type": "module",
  "bin": {
    "rdoc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:obsidian": "npm run build --prefix plugins/obsidian-rdoc",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "dev": "tsc --watch",
    "rdoc": "node dist/cli.js",
    "test:conformance": "node tests/conformance/run.mjs",
    "test:fuzz": "node tests/fuzz/sanitize-fuzz.mjs",
    "pack:dry": "npm pack --dry-run",
    "docker:build": "docker build -t ghcr.io/dokaiimob/rdoc:local .",
    "rdoc:bun": "bun dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rdoc",
    "responsive-document",
    "markdown",
    "offline",
    "ebook"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "katex": "^0.16.21",
    "marked": "^14.1.3",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.1",
    "@types/prismjs": "^1.26.5",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
