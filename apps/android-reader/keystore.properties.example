# Copy to keystore.properties (gitignored) and fill in real values.
# Never commit keystore.properties, *.jks, or *.keystore.
#
# Alternative: set env vars instead of this file (CI / local secrets):
#   RDOC_KEYSTORE_FILE      absolute path to .jks / .keystore
#   RDOC_KEYSTORE_PASSWORD  store password
#   RDOC_KEY_ALIAS          key alias
#   RDOC_KEY_PASSWORD       key password

storeFile=release.keystore
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=rdoc
keyPassword=CHANGE_ME_KEY_PASSWORD
