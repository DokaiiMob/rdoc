{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rdoc.dev/schemas/rdoc-manifest-1.0.json",
  "title": "RdocManifest",
  "description": "Embedded manifest for Responsive Document (.rdoc) format 1.x (RFC 0001 Accepted; optional 1.1.0 fields allowed via additionalProperties).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "title",
    "author",
    "created",
    "lang",
    "contentHash",
    "readingMinutes",
    "wordCount"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "rdoc",
      "description": "Format identifier; always the string \"rdoc\"."
    },
    "version": {
      "type": "string",
      "description": "SemVer of the format dialect (e.g. \"1.0.0\")."
    },
    "title": {
      "type": "string",
      "description": "Human-readable document title."
    },
    "author": {
      "type": "string",
      "description": "Author name; may be \"Anonymous\"."
    },
    "created": {
      "type": "string",
      "description": "ISO-8601 timestamp; preferably UTC with Z."
    },
    "lang": {
      "type": "string",
      "description": "BCP-47 language tag for the document."
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 of canonicalized article inner HTML (RFC 0001 §7)."
    },
    "readingMinutes": {
      "type": "integer",
      "minimum": 1,
      "description": "Estimated reading time in whole minutes."
    },
    "wordCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Word count of the article content."
    },
    "description": {
      "type": "string",
      "description": "Optional short summary."
    },
    "profile": {
      "type": "string",
      "enum": ["article", "slides", "contract", "paper"],
      "description": "Optional document profile hint for readers and tooling."
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri",
      "description": "Optional canonical URL when a web twin exists."
    },
    "license": {
      "type": "string",
      "description": "Optional SPDX license identifier (e.g. \"MIT\", \"CC-BY-4.0\")."
    },
    "rights": {
      "type": "string",
      "description": "Optional free-form rights / copyright statement."
    }
  }
}
